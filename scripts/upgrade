#!/bin/bash

source /usr/share/yunohost/helpers
source _common.sh

ynh_script_progression "Stopping Sixteen..."
ynh_systemctl --service="$app" --action=stop

ynh_nodejs_install

ynh_script_progression "Upgrading source files..."
cp -a "$YNH_APP_BASEDIR/." "$install_dir/"
chown -R "$app:$app" "$install_dir"

ynh_script_progression "Building Sixteen..."
pushd "$install_dir"
    PATH="$path_with_nodejs:$PATH"
    ynh_exec_as_app npm ci
    ynh_exec_as_app env NITRO_PRESET=node-server npm run build
popd
chown -R "$app:$app" "$install_dir"

ynh_app_setting_set --key=nodejs_dir --value="$nodejs_dir"
ynh_app_setting_set --key=path_with_nodejs --value="$path_with_nodejs"

ensure_style_settings
write_branding

ynh_script_progression "Upgrading NGINX and systemd..."
ynh_config_add_nginx
ynh_config_add_systemd

ynh_script_progression "Starting Sixteen..."
ynh_systemctl --service="$app" --action=start

ynh_script_progression "Upgrade of $app completed"
